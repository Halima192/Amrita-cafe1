# Supabase Realtime multiplayer (cross-device games)
# 1. Create a project at https://supabase.com
# 2. Run supabase/migrations/001_game_rooms.sql in the SQL Editor
# 3. Enable Realtime for table public.game_rooms (Publication)
# 4. Paste Project URL + anon public key below, then restart `npm run dev`

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
